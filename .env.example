# Copy to .env and fill in. Never commit .env.

# --- Mode ---
# public: cloud best-of-breed (Groq/ElevenLabs Scribe + Claude + ElevenLabs TTS). Fast, filtered.
# private: fully local (Phase 7). Faster-Whisper + Qwen3 14B instruct + MOSS-TTS-Nano, no network.
AIDM_MODE=public

# --- Transport ---
# local: PyAudio mic + speaker (CLI; today's path).
# webrtc: browser client over WebRTC (Phase 6).
AIDM_TRANSPORT=local

# --- Public-mode API keys (required when AIDM_MODE=public) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=                           # https://openrouter.ai/keys — one key, every major model
ELEVENLABS_API_KEY=

# --- Optional overrides (public mode) ---
# GROQ_STT_MODEL=whisper-large-v3-turbo       # or whisper-large-v3 for slightly higher quality
# OPENROUTER_MODEL=google/gemini-2.5-flash    # other options: anthropic/claude-sonnet-4.5, anthropic/claude-sonnet-4.6, openai/gpt-5, deepseek/deepseek-chat, ...
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB    # default voice; used when no per-locale override is set
# ELEVENLABS_VOICE_ID_HU=                     # optional: distinct voice for Hungarian sessions
# ELEVENLABS_VOICE_ID_EN=                     # optional: distinct voice for English sessions
# ELEVENLABS_MODEL=eleven_multilingual_v2     # eleven_v3 for inline emotion tags (alpha, tier-gated)
# AIDM_LOCALE=en                              # en | hu (default: en)
# AIDM_PROMPT_FILE=                           # absolute path to override persona
# AIDM_LOG_LEVEL=INFO                         # DEBUG for verbose pipecat tracing
# AUDIO_INPUT_DEVICE=                         # PyAudio device index (see `make audio-devices`); empty = system default
# AUDIO_OUTPUT_DEVICE=                        # On PipeWire systems try the 'pipewire' device for Bluetooth routing
# AIDM_SERVER_HOST=127.0.0.1                  # bind address for the orchestrator and, via scripts/dev-start.sh, the vite dev server. Dev runs have no auth (CF_ACCESS_DISABLED=1), so keep loopback; set 0.0.0.0 in your shell (not here) to reach it over LAN/Tailscale
# --- Vault layout ---
# AIDM_VAULT_ROOT=                            # absolute path to the dir holding all campaigns; empty = derived from VAULT_PATH.parent (default: repo's vault/)
# VAULT_PATH=                                 # absolute path to the *default* campaign vault — used by the local CLI and as the picker's initial selection. Empty = repo's vault/ember-hollow/
# RUN_SLUG=                                   # default run for sessions that don't supply one (local CLI uses it; web picker overrides per session)
# AIDM_CAMPAIGN_SLUG=ember-hollow                      # under docker compose: selects vault/<slug>/ as the default campaign

# --- Production / public deploy (webrtc transport behind nginx + Cloudflare) ---
# AIDM_ALLOWED_ORIGINS=https://aidm.example.com   # comma-separated; empty = dev defaults
# AIDM_PUBLIC_IP=                                 # VPS public IPv4 — ICE host candidate so browsers find media plane
# AIDM_MAX_CONCURRENT_SESSIONS=3                  # hard cap, 503 over it; sized for ≤10 USD/month budget
# AIDM_SESSION_TOKEN_CAP=20000                    # input+output tokens per session; over → polite session-end
# AIDM_SESSION_TTS_CHAR_CAP=5000                  # ElevenLabs characters per session
# AIDM_DAILY_USD_CAP=0.30                         # global daily $-budget; over → 503 on /api/offer + /api/text/session
# AIDM_BUDGET_DB_PATH=/data/budget.db             # SQLite path; container writes here, host bind-mounts ./data
# AIDM_RATE_LIMIT_OFFER=5/minute                  # per-IP cap on /api/offer
# AIDM_RATE_LIMIT_SESSION=10/minute               # per-IP cap on /api/text/session

# --- Cloudflare Access JWT verification (defense in depth behind CF proxy) ---
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=                                  # Application Audience tag from the CF Access app
# CF_ACCESS_DISABLED=1                            # SET ONLY IN LOCAL DEV — skips JWT verification
# NOTE: when CF_ACCESS_DISABLED is not 1, both CF_ACCESS_TEAM_DOMAIN and
# CF_ACCESS_AUD MUST be set AND AIDM_ALLOWED_ORIGINS MUST be non-empty —
# the orchestrator refuses to boot in an open-by-default posture.

# --- TURN relay (optional, recommended for prod) ---
# STUN alone fails behind symmetric NAT / strict corporate firewalls.
# Point at a TURN server (coturn, twilio, etc.) for reliable media plane.
# AIDM_TURN_URL=turn:turn.example.com:3478
# AIDM_TURN_USERNAME=
# AIDM_TURN_CREDENTIAL=

# --- Private-mode endpoints ---
# Defaults match the docker compose service names on the internal `private-net`
# network, so `make up-private` works without touching these. Set them when
# running individual services on the host (e.g. for an ad-hoc bench against a
# port-forwarded llama-server).
# AIDM_LOCAL_LLM_URL=http://llm-gateway:8002/v1   # bench: http://localhost:8002/v1
# AIDM_LOCAL_LLM_MODEL=qwen3-14b   # cosmetic; llama.cpp serves the loaded GGUF
# AIDM_LOCAL_STT_URL=http://stt:8001
# AIDM_LOCAL_TTS_URL=ws://tts:8003/v1/tts/stream
# AIDM_LOCAL_TTS_SPEAKER=/voices/dm_hu.wav        # mount ./voices/ into the container

# --- Private-mode model knobs (compose overrides) ---
# Compose default is Qwen/Qwen3-14B instruct Q5_K_M (resists
# confabulation, native tool-calling). Fetch it with:
#   hf download Qwen/Qwen3-14B-GGUF \
#     Qwen3-14B-Q5_K_M.gguf --local-dir ./models/qwen3
# Any tool-calling GGUF works; creative finetunes want temp ~0.65 and the
# DRY sampler below:
# AIDM_LLM_MODEL_PATH=/models/qwen3/Qwen3-14B-Q5_K_M.gguf
# AIDM_LLM_CTX_SIZE=16384                     # 16k ctx; Q5_K_M fits on 16GB GPU with KV cache headroom
# AIDM_LLM_KV_CACHE_TYPE=q8_0                 # quantized KV cache, keeps long sessions in VRAM
#                                             # (asymmetric f16-K/q8_0-V rejected by the CUDA FA kernel)
# AIDM_LLM_GPU_LAYERS=99                      # full offload: ~10GB weights + 1.5GB Whisper on 16GB card
# AIDM_LLM_PARALLEL=1                         # single-session DM; concurrency wrecks KV-cache locality
# AIDM_LLM_REASONING_BUDGET=0                 # force-close stray <think> blocks (layer 2)
# AIDM_LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}  # kill Qwen3 thinking at the template (layer 1, default)
# AIDM_LLM_CACHE_REUSE=256                    # chunked KV reuse; auto-dropped when K cache is quantized
# AIDM_LLM_DRY_MULTIPLIER=0.8                 # DRY anti-repetition; 0.0 = off (compose default)
# AIDM_LLM_DRY_BASE=1.75
# AIDM_LLM_DRY_ALLOWED_LENGTH=2
# AIDM_LLM_DRY_PENALTY_LAST_N=2048            # recent-window only — static persona/sheets never penalized
# Speculative decoding: measured net-NEGATIVE on this rig (37 -> 34.5 tok/s,
# RP sampler stack kills acceptance; draft KV also breaks prompt-cache
# restore). Knobs kept for other model/sampler combos:
# AIDM_LLM_DRAFT_MODEL_PATH=/models/qwen3/Qwen3-0.6B-Q8_0.gguf
# AIDM_LLM_DRAFT_GPU_LAYERS=99

# --- Private-mode sampling (orchestrator request body, no rebuild) ---
# Model-dependent: instruct wants low temp against
# confabulation; creative finetunes want ~0.65 or they flatten.
# AIDM_LLM_TEMPERATURE=0.65
# AIDM_LLM_TOP_P=0.95
# AIDM_LLM_MIN_P=0.1                          # llama.cpp-only; routed via extra_body
# AIDM_LLM_FREQUENCY_PENALTY=0.3
# AIDM_LLM_PRESENCE_PENALTY=0.2
# WHISPER_MODEL=large-v3-turbo                # distilled Large-v3, ~5x faster decode
# WHISPER_DEVICE=cuda                         # cpu = evict from GPU when VRAM is contested
# WHISPER_COMPUTE_TYPE=int8_float16           # float16 trades VRAM for quality
# MOSS_TTS_DEVICE=cpu                         # MOSS-TTS-Nano runs on CPU; cuda would just hog VRAM
# MOSS_TTS_CHECKPOINT=/models/moss-tts
# MOSS_TTS_AUDIO_TOKENIZER=/models/moss-audio-tokenizer

# --- NPC state-refresh failsafe (DM-retry side-car) ---
# Catches the "DM narrated a beat shift but didn't call npc_update_state"
# failure mode. Bilingual regex detector flags it, then re-prompts the
# DM up to N times with escalating force (final attempt uses
# tool_choice="required"). Counters on SessionNPCRegistry track how
# often it earns its keep. See aidm/npc_state_failsafe.py.
# AIDM_NPC_FAILSAFE_ENABLED=true               # set to false to bench DM-only baseline
# AIDM_NPC_FAILSAFE_MAX_ATTEMPTS=3             # 1=just gentle, 2=+ explicit, 3=+ forced
# AIDM_NPC_FAILSAFE_MAX_TOKENS=400             # cap per retry
# AIDM_NPC_FAILSAFE_TIMEOUT_S=60.0             # per-retry timeout (Qwen3 14B Q5 needs 10-30s typical)
