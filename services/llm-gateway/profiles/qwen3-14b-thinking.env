# Model profile: Qwen3-14B instruct with DM thinking on.
# Same model as qwen3-14b.env; samplers from the Qwen3 model card's
# thinking-mode recommendation (https://huggingface.co/Qwen/Qwen3-14B:
# "Temperature=0.6, TopP=0.95, TopK=20, and MinP=0"). Every value that
# differs from qwen3-14b.env carries its source on the line above it.
AIDM_PROFILE=qwen3-14b-thinking

# --- gateway ---
# placeholder path, same file as qwen3-14b.env
AIDM_LLM_MODEL_PATH=/models/qwen3/Qwen3-14B-Q5_K_M.gguf
AIDM_LLM_CTX_SIZE=16384
AIDM_LLM_GPU_LAYERS=99
AIDM_LLM_N_CPU_MOE=0
AIDM_LLM_KV_CACHE_TYPE=q8_0
# card lists no repetition penalty -> llama.cpp neutral 1.0
AIDM_LLM_REPEAT_PENALTY=1.0
# card, thinking mode: top_k=20
AIDM_LLM_TOP_K=20
AIDM_LLM_DRY_MULTIPLIER=0
# our choice, no card value: caps DM thinking at 1024 tokens to bound turn latency
AIDM_LLM_REASONING_BUDGET=1024
# empty = gateway default {"enable_thinking":false}: side calls (writer/summary/minds/critic) stay non-thinking; the DM request overrides per call
AIDM_LLM_CHAT_TEMPLATE_KWARGS=
# thoughts returned as reasoning_content deltas, never in content (llama-server --help: deepseek format)
AIDM_LLM_EXTRA_FLAGS='--reasoning-format deepseek'
AIDM_LLM_CUDA_GRAPHS=1

# --- orchestrator ---
# model label only (llama-server ignores it)
AIDM_LOCAL_LLM_MODEL=qwen3-14b
# card, thinking mode: temperature=0.6
AIDM_LLM_TEMPERATURE=0.6
AIDM_LLM_TOP_P=0.95
# card, thinking mode: min_p=0
AIDM_LLM_MIN_P=0.0
# card lists none -> neutral 0
AIDM_LLM_FREQUENCY_PENALTY=0.0
# card lists none -> neutral 0
AIDM_LLM_PRESENCE_PENALTY=0.0
# card: thinking is the model's default mode; DM call only
AIDM_DM_THINKING=1
AIDM_GUARD_TICS=1
AIDM_GUARD_PARAGRAPH=1
AIDM_GUARD_REPLAY=1
AIDM_GUARD_DIRECTIVES=1
