# Model profile: Qwen3-14B instruct on the default harness (the baseline).
# Flat KEY=VALUE, POSIX-sh sourceable (`set -a; . file`): gateway vars (AIDM_LLM_*
# mapped by docker-compose.yml) + orchestrator vars (aidm/config.py). Comments
# sit on their own line, never inline; single-quote values with spaces.
# Apply: see services/llm-gateway/README.md ("Model profiles").
# Every value equals the compose, entrypoint or aidm/config.py default.
AIDM_PROFILE=qwen3-14b

# --- gateway (llm-gateway container) ---
# placeholder path: hf download Qwen/Qwen3-14B-GGUF Qwen3-14B-Q5_K_M.gguf --local-dir ./models/qwen3
AIDM_LLM_MODEL_PATH=/models/qwen3/Qwen3-14B-Q5_K_M.gguf
AIDM_LLM_CTX_SIZE=16384
AIDM_LLM_GPU_LAYERS=99
AIDM_LLM_N_CPU_MOE=0
AIDM_LLM_KV_CACHE_TYPE=q8_0
AIDM_LLM_REPEAT_PENALTY=1.15
AIDM_LLM_TOP_K=40
AIDM_LLM_DRY_MULTIPLIER=0
AIDM_LLM_REASONING_BUDGET=0
# empty = entrypoint default {"enable_thinking":false}
AIDM_LLM_CHAT_TEMPLATE_KWARGS=
AIDM_LLM_EXTRA_FLAGS=
AIDM_LLM_CUDA_GRAPHS=1

# --- orchestrator (DM request + guards) ---
# model label only (llama-server ignores it)
AIDM_LOCAL_LLM_MODEL=qwen3-14b
# low temperature + min_p tail cut against confabulation (aidm/config.py)
AIDM_LLM_TEMPERATURE=0.35
AIDM_LLM_TOP_P=0.95
AIDM_LLM_MIN_P=0.1
AIDM_LLM_FREQUENCY_PENALTY=0.3
AIDM_LLM_PRESENCE_PENALTY=0.2
AIDM_DM_THINKING=0
AIDM_GUARD_TICS=1
AIDM_GUARD_PARAGRAPH=1
AIDM_GUARD_REPLAY=1
AIDM_GUARD_DIRECTIVES=1
